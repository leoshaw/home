[user]
  name = Leo Shaw
  email = leo@leoshaw.co.uk
	signingkey = 09BE80BDDD94BC60
[alias]
  ff = merge --ff-only
  st = status
  pr = pull --rebase
  co = checkout
  pick = cherry-pick
  ignored = !git ls-files -v | grep "^[[:lower:]]"
  cleanup = "!git branch --merged main | grep  -v '\\*\\|main\\|develop' | xargs -n 1 git branch -d"
[merge]
  conflictstyle = diff3
[rerere]
  enabled = true
[push]
  default = current
[core]
  autocrlf = false
[commit]
	gpgsign = true
[init]
	defaultBranch = main
